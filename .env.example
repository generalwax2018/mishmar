# Set these in your host's secret settings, or copy to .env (never commit it)
# and start with: node --env-file=.env src/server.js

# 32 random bytes, base64. Generate it with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy in a password manager. Without it, the database and backups can't be read.
MISHMAR_MASTER_KEY=

# Contact for web push (required by Apple and Google push services)
VAPID_SUBJECT=mailto:security@example.org

# Set to 1 when running behind an HTTPS proxy (Fly.io, Render, Caddy, nginx...)
TRUST_PROXY=1

PORT=3000
# MISHMAR_DATA=/data                 # where the database and photos live
# MAP_TILE_URL=https://tile.example.org/{z}/{x}/{y}.png
# MISHMAR_SOURCE_URL=https://github.com/you/your-fork   # set this if you modify Mishmar (AGPL section 13)
# MISHMAR_BACKUP_KEEP=14

# Development only. Never set these in production:
# MISHMAR_INSECURE_COOKIES=1
# MISHMAR_FAKE_NOW=2026-11-06T23:00:00Z
